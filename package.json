{
  "name": "anomalia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run content && vite",
    "build": "npm run content && tsc -b && vite build && node scripts/spa-fallback.mjs",
    "preview": "vite preview",
    "content": "tsx scripts/build-content.ts",
    "content:strict": "tsx scripts/build-content.ts --strict",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check": "npm run content && npm run typecheck && npm run lint && npm run format:check && npm run test",
    "db:push": "node scripts/sb.mjs db push",
    "functions:deploy": "node scripts/sb.mjs functions deploy partida --use-api",
    "teacher:add": "tsx scripts/add-teacher.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "db:types": "node scripts/gen-types.mjs",
    "ai:probe": "tsx scripts/ai-probe.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "gsap": "3.15.0",
    "howler": "2.2.4",
    "inkjs": "2.4.0",
    "pixi.js": "8.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/howler": "2.2.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
