# ─────────────────────────────────────────────────────────────────────────────
# ANOMALÍA · variables de entorno
# Copia este archivo a `.env.local` (no se sube al repo) y rellénalo.
# ─────────────────────────────────────────────────────────────────────────────

# ── Front (Vite). PÚBLICAS: acaban en el navegador. Solo el prefijo VITE_. ──
# Panel de Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Clave «publishable» (sb_publishable_…). Nunca la secreta.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Ruta base del sitio. En GitHub Pages es /anomalia/; en local, /.
VITE_BASE_PATH=/

# ── Solo para scripts y tests locales. SECRETAS: nunca con prefijo VITE_. ──
# Referencia del proyecto (el subdominio de VITE_SUPABASE_URL).
SUPABASE_PROJECT_REF=xxxxxxxxxxxxxxxxxxxx
# Clave secreta (sb_secret_…): salta la RLS. Solo para seed, teacher:add y tests.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
# Contraseña de la base de datos (para `npm run db:push`).
SUPABASE_DB_PASSWORD=
# Token personal de Supabase (Account → Access Tokens). Alternativa a `npx supabase login`.
SUPABASE_ACCESS_TOKEN=
# Contraseña común de los 30 alumnos simulados de `npm run seed:demo`.
SIM_PASSWORD=
# Contraseña del docente de demostración que crea `npm run seed:demo`.
DEMO_TEACHER_PASSWORD=

# ── Secretos de las Edge Functions (no se leen de aquí) ──
# Se cargan en Supabase con:  npx supabase secrets set NOMBRE=valor
# ALLOWED_ORIGINS  orígenes permitidos por CORS, separados por comas.
#                  Ej.: https://ray86-dev.github.io,http://localhost:5173
# AI_PROVIDER      (M2) proveedor de IA
# AI_MODEL         (M2) modelo
# AI_API_KEY       (M2) clave del proveedor: SOLO en Supabase, nunca aquí ni en el front
# AI_BASE_URL      (M2) URL base de la API del proveedor
